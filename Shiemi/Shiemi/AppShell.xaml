<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="Shiemi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chatpages="clr-namespace:Shiemi.Pages.Chats"
    xmlns:devpages="clr-namespace:Shiemi.Pages.Dev"
    xmlns:marketpages="clr-namespace:Shiemi.Pages.Market"
    xmlns:startpages="clr-namespace:Shiemi.Pages.Start"
    xmlns:userpages="clr-namespace:Shiemi.Pages.User"
    xmlns:viewmodels="clr-namespace:Shiemi.ViewModels"
    FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="True">
    <FlyoutItem Title="GetStarted" FlyoutItemIsVisible="False">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate startpages:Index}" Route="Index" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Profile" FlyoutIcon="ic_fluent_person_28_regular.png">
        <Tab FlyoutIcon="ic_fluent_home_28_regular.png">
            <ShellContent
                ContentTemplate="{DataTemplate userpages:Profile}"
                FlyoutIcon="ic_fluent_home_28_regular.png"
                Route="Profile" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Home" FlyoutIcon="ic_fluent_home_28_regular.png">
        <Tab Title="Project Hub" Icon="ic_fluent_grid_28_filled.png">
            <ShellContent ContentTemplate="{DataTemplate userpages:Home}" Route="HomeProjects" />
        </Tab>
        <Tab Title="DevHub" Icon="ic_fluent_people_28_filled.png">
            <ShellContent
                Title="Manage Clients"
                ContentTemplate="{DataTemplate userpages:DevHub}"
                Route="DevHub" />
        </Tab>
    </FlyoutItem>


    <FlyoutItem Title="Shop" FlyoutIcon="ic_fluent_shopping_bag_28_regular.png">
        <Tab Title="Projects">
            <ShellContent ContentTemplate="{DataTemplate marketpages:ProjectShop}" Route="ProjectShop" />
        </Tab>

        <Tab Title="Devs">
            <ShellContent ContentTemplate="{DataTemplate devpages:Market}" Route="DevMarket" />
        </Tab>
    </FlyoutItem>

    <Shell.FlyoutFooterTemplate>
        <DataTemplate x:DataType="viewmodels:FlyoutFooterModel">
            <Grid
                ColumnDefinitions="*,2*"
                ColumnSpacing="8"
                RowDefinitions="Auto">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 100">
                    <Image Source="{x:Binding Profile}" />

                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Padding="0,8,0,0"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="PoppinsBold"
                        FontSize="16"
                        Text="{x:Binding Username}" />

                    <Label Text="{x:Binding Role}" />
                </VerticalStackLayout>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{x:Binding GoToProfileCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>
</Shell>
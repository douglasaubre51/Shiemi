<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Shiemi.Pages.Chats.Rooms"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodel="clr-namespace:Shiemi.PageModels.Chat"
    xmlns:viewmodels="clr-namespace:Shiemi.ViewModels"
    xmlns:views="clr-namespace:Shiemi.Views"
    Title="{x:Binding CurrentProject.Title,
                      StringFormat='{0} Chats'}"
    x:DataType="pagemodel:RoomsPageModel"
    Shell.TabBarIsVisible="False">
    <Grid ColumnDefinitions="*,2*" RowDefinitions="*">
        <!--  chat list  -->
        <CollectionView
            Grid.Column="0"
            ItemsLayout="VerticalList"
            ItemsSource="{x:Binding ChatCollection}"
            ItemsUpdatingScrollMode="KeepLastItemInView"
            SelectionChanged="CollectionView_SelectionChanged"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ChatRoomViewModel">
                    <!--  chat  -->
                    <Grid
                        Padding="20"
                        ColumnDefinitions="*"
                        RowDefinitions="*">
                        <Label LineBreakMode="TailTruncation" Text="{x:Binding Title}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    Padding="16,0,0,0"
                    FontSize="16"
                    Text="Contacts will be shown here!"
                    TextColor="LightGrey" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!--  chat area  -->
        <views:MessageView
            Grid.Column="1"
            BackgroundColor="WhiteSmoke"
            DidChatSelected="{x:Binding ChatWasSelected}"
            MessageCollection="{x:Binding MessageCollection}"
            SenderName="{x:Binding Sender}" />
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Shiemi.Pages.Project.AddDevs"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Shiemi.Models.ProjectModels"
    xmlns:pagemodels="clr-namespace:Shiemi.PageModels.Project"
    Title="Manage Developers"
    x:DataType="pagemodels:AddDevsPageModel"
    Shell.TabBarIsVisible="False">
    <VerticalStackLayout>
        <CollectionView
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding DeveloperCardCollection}"
            SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DeveloperCardModel">
                    <VerticalStackLayout
                        Padding="16,8"
                        BackgroundColor="GhostWhite"
                        Spacing="4">
                        <HorizontalStackLayout Spacing="4">
                            <Label Style="{StaticResource CardTitleLabel}" Text="{Binding FirstName}" />
                            <Label Style="{StaticResource CardTitleLabel}" Text="{Binding LastName}" />
                        </HorizontalStackLayout>
                        <Label FontSize="Caption" Text="{Binding Email}" />

                        <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                            <Button
                                BackgroundColor="Green"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pagemodels:AddDevsPageModel}}, x:DataType=pagemodels:AddDevsPageModel, Path=AddDevToProjectCommand}"
                                CommandParameter="{Binding Id}"
                                Text="Add" />
                            <Button
                                BackgroundColor="Red"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pagemodels:AddDevsPageModel}}, x:DataType=pagemodels:AddDevsPageModel, Path=RemoveDevFromProjectCommand}"
                                CommandParameter="{Binding Id}"
                                Text="Remove" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
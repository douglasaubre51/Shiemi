<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Shiemi.Pages.Start.GotBanned"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:Shiemi.PageModels.Start"
    Title="GotBanned"
    x:DataType="pagemodels:GotBannedPageModel"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <Grid Margin="16" RowDefinitions="*,Auto">
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="16"
            VerticalOptions="Center">
            <Label
                FontSize="Title"
                HorizontalOptions="Center"
                Text="You have been banned due to user reports !"
                TextColor="Red"
                VerticalOptions="Center" />

            <Button
                Command="{x:Binding GoToLoginCommand}"
                HorizontalOptions="Center"
                Text="Go to login" />
        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            HorizontalOptions="End"
            Text="Lift the ban ?"
            TextColor="HotPink"
            VerticalOptions="End">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding SendReportEmailHandlerCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Shiemi.Pages.User.Profile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodel="clr-namespace:Shiemi.PageModels.User"
    Title="Profile"
    x:DataType="pagemodel:ProfilePageModel"
    SafeAreaEdges="Default"
    Shell.NavBarIsVisible="True">
    <Grid
        Margin="16,0,0,0"
        ColumnDefinitions="*,*"
        ColumnSpacing="16"
        IsClippedToBounds="False"
        RowDefinitions="Auto,Auto"
        RowSpacing="16">
        <!--  user details card  -->
        <Grid
            Grid.ColumnSpan="2"
            ColumnDefinitions="Auto,Auto"
            ColumnSpacing="16"
            IsClippedToBounds="False"
            RowDefinitions="Auto,Auto">
            <Border
                Grid.RowSpan="2"
                Grid.Column="0"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.Shadow>
                    <Shadow
                        Opacity="0.4"
                        Radius="10"
                        Offset="1,1" />
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Image
                    Aspect="AspectFill"
                    HeightRequest="250"
                    Source="{Binding ProfileURL}"
                    WidthRequest="360" />
            </Border>

            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                <Label FontSize="56" Text="{Binding UserName}" />

                <Label
                    Margin="0,0,0,40"
                    FontSize="15"
                    Text="{Binding Email}"
                    TextColor="Grey" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                Grid.Row="1"
                Grid.Column="1"
                Spacing="8"
                VerticalOptions="End">
                <Button
                    Command="{Binding GoToProfileEditPageCommand}"
                    HorizontalOptions="End"
                    ImageSource="ic_fluent_edit_person_24_regular.png"
                    Style="{StaticResource IconStyle}" />
                <!--  separator  -->
                <BoxView Style="{StaticResource VerticalSeperator}" />

                <Button
                    Command="{Binding LogoutCommand}"
                    HorizontalOptions="Start"
                    ImageSource="ic_fluent_sign_out_24_regular.png"
                    Style="{StaticResource WarningIconStyle}"
                    Text="Logout"
                    TextColor="Black" />
            </HorizontalStackLayout>
        </Grid>

        <!--  dev profile  -->
        <Border
            x:Name="DevProfileCard_NotJoined"
            Grid.Row="1"
            IsVisible="{Binding ShowDevCard_NotJoined}"
            Stroke="Transparent"
            VerticalOptions="Start">
            <VerticalStackLayout>
                <Label Style="{StaticResource TitleLabel}" Text="Dev Profile" />

                <Label Text="Become a dev and get hired !" />

                <Button
                    Margin="0,16,0,0"
                    Command="{Binding GoToDevEditPageCommand}"
                    HorizontalOptions="Start"
                    Text="Start now" />
            </VerticalStackLayout>
        </Border>

        <!--  dev sign  -->
        <Label
            Grid.Row="1"
            Grid.ColumnSpan="2"
            FontFamily="PoppinsBold"
            FontSize="300"
            IsVisible="{x:Binding DevModeActive}"
            Text="DEV"
            TextColor="LightGrey" />
    </Grid>
</ContentPage>
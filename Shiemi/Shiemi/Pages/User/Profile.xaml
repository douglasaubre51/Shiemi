<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Shiemi.Pages.User.Profile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodel="clr-namespace:Shiemi.PageModels.User"
    x:DataType="pagemodel:ProfilePageModel"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <OnIdiom x:TypeArguments="ColumnDefinitionCollection">
                    <OnIdiom.Phone>
                        <ColumnDefinitionCollection>
                            <ColumnDefinition Width="*" />
                        </ColumnDefinitionCollection>
                    </OnIdiom.Phone>

                    <OnIdiom.Desktop>
                        <ColumnDefinitionCollection>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </ColumnDefinitionCollection>
                    </OnIdiom.Desktop>
                </OnIdiom>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <OnIdiom x:TypeArguments="RowDefinitionCollection">
                    <OnIdiom.Phone>
                        <RowDefinitionCollection>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </RowDefinitionCollection>
                    </OnIdiom.Phone>

                    <OnIdiom.Desktop>
                        <RowDefinitionCollection>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </RowDefinitionCollection>
                    </OnIdiom.Desktop>
                </OnIdiom>
            </Grid.RowDefinitions>

            <Border
                Grid.RowSpan="{OnIdiom Default=2,
                                       Phone=1}"
                Grid.Column="0"
                Margin="10"
                HorizontalOptions="{OnIdiom Default=Start,
                                            Phone=Center}"
                Shadow="0 1 10 rgba(0,0,0,0.14)"
                Stroke="WhiteSmoke"
                StrokeShape="RoundRectangle 90"
                StrokeThickness="5">

                <Image
                    Aspect="AspectFill"
                    HeightRequest="180"
                    Source="{Binding ProfileURL}"
                    WidthRequest="180" />
            </Border>

            <VerticalStackLayout Grid.Row="{OnIdiom Default=0, Phone=1}" Grid.Column="{OnIdiom Default=1, Phone=0}">
                <Label
                    FontFamily="PoppinsSemiBold"
                    FontSize="{OnIdiom Default=32,
                                       Phone=24}"
                    HorizontalOptions="Center"
                    Text="{Binding UserName}" />

                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="{Binding Email}"
                    TextColor="Purple" />

                <Label
                    FontFamily="PoppinsRegular"
                    FontSize="{OnIdiom Default=16,
                                       Phone=12}"
                    HorizontalOptions="Center"
                    IsVisible="{x:Binding DevModeActive}"
                    Text="Developer" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                Grid.Row="{OnIdiom Default=1,
                                   Phone=2}"
                Grid.Column="{OnIdiom Default=1,
                                      Phone=0}"
                Margin="0,16,0,0"
                HorizontalOptions="Center"
                Spacing="8"
                VerticalOptions="End">
                <Button
                    Command="{Binding GoToProfileEditPageCommand}"
                    HorizontalOptions="End"
                    ImageSource="ic_fluent_edit_person_24_regular.png"
                    Style="{StaticResource IconStyle}" />

                <!--  separator  -->
                <BoxView Style="{StaticResource VerticalSeperator}" />

                <Button
                    Command="{Binding LogoutCommand}"
                    HorizontalOptions="Start"
                    ImageSource="ic_fluent_sign_out_24_regular.png"
                    Style="{StaticResource WarningIconStyle}"
                    Text="Logout"
                    TextColor="Black" />
            </HorizontalStackLayout>
        </Grid>

        <!--  dev profile  -->
        <Border
            x:Name="DevProfileCard_NotJoined"
            Grid.Row="1"
            IsVisible="{Binding ShowDevCard_NotJoined}"
            Stroke="Transparent"
            VerticalOptions="Start">
            <VerticalStackLayout>
                <Label Style="{StaticResource TitleLabel}" Text="Dev Profile" />

                <Label Text="Become a dev and get hired !" />

                <Button
                    Margin="0,16,0,0"
                    Command="{Binding GoToDevEditPageCommand}"
                    HorizontalOptions="Start"
                    Text="Start now" />
            </VerticalStackLayout>
        </Border>

        <Label
            Grid.Row="2"
            Grid.Column="1"
            HorizontalOptions="End"
            Text="Report an account ?"
            TextColor="HotPink"
            VerticalOptions="End">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding SendReportEmailHandlerCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentPage>
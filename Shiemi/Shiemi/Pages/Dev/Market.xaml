<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Shiemi.Pages.Dev.Market"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:devpagemodels="clr-namespace:Shiemi.PageModels.Dev"
    xmlns:dtos="clr-namespace:Shiemi.Dtos"
    xmlns:handlers="clr-namespace:Shiemi.Utilities.Handlers"
    xmlns:models="clr-namespace:Shiemi.Models"
    x:DataType="devpagemodels:MarketpageModel"
    Shell.NavBarIsVisible="True">
    <Shell.SearchHandler>
        <handlers:DevSearchHandler>
            <handlers:DevSearchHandler.ItemTemplate>
                <DataTemplate x:DataType="dtos:SearchDevDto">
                    <VerticalStackLayout Padding="16" Spacing="16">
                        <Label Text="{x:Binding Username}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </handlers:DevSearchHandler.ItemTemplate>
        </handlers:DevSearchHandler>
    </Shell.SearchHandler>
    <!--  dev cards  -->
    <VerticalStackLayout Margin="10">
        <ActivityIndicator IsRunning="{x:Binding IsBusy}" IsVisible="{x:Binding IsBusy}" />

        <CollectionView x:Name="DevCollectionView">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="8"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <!--  dev card  -->
                <DataTemplate x:DataType="models:DevModel">
                    <Border StrokeThickness="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="VisualStateManager.VisualStateGroups">
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="WhiteSmoke" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{x:StaticResource PrimaryDark}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </Setter>
                            </Style>
                        </Border.Style>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*,*,Auto">
                            <!--  touch  -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type devpagemodels:MarketpageModel}}, x:DataType=devpagemodels:MarketpageModel, Path=GoToDetailsPageCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource ImageCardBorderStyle}">
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="200"
                                    HorizontalOptions="Fill"
                                    Source="{Binding Profile}" />
                            </Border>

                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="4,0,0,0"
                                FontFamily="PoppinsBold"
                                FontSize="24"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Username}" />

                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="4,0,0,0"
                                FontSize="16"
                                LineBreakMode="TailTruncation"
                                Text="{Binding ShortDesc}" />

                            <VerticalStackLayout
                                Grid.Row="3"
                                Grid.Column="0"
                                Padding="4"
                                VerticalOptions="End">
                                <Label
                                    FontSize="10"
                                    Text="Starts at"
                                    TextColor="Grey" />

                                <Label FontSize="16" Text="{Binding StartingPrice, StringFormat='₹{0}'}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Row="3"
                                Grid.Column="1"
                                Padding="4"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                                <Label
                                    FontSize="10"
                                    Text="Developer"
                                    TextColor="Grey" />

                                <Label Text="{Binding Username}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    FontSize="Body"
                    HorizontalTextAlignment="Center"
                    Text="Devs will be shown here !"
                    TextColor="LightGrey" />
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Shiemi.Views.ProfileCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Shiemi.Views"
    x:DataType="views:ProfileCard">
    <Border Margin="10" Style="{x:StaticResource FluentCardBorderStyle}">
        <Grid
            Padding="8"
            ColumnDefinitions="Auto,Auto"
            RowDefinitions="Auto,*"
            Style="{x:StaticResource FluentCardContentStyle}">
            <Border Grid.Row="0" Style="{x:StaticResource FluentCardAvatarStyle}">
                <Image
                    x:Name="ProfileImage"
                    Grid.Row="0"
                    Aspect="AspectFill" />
            </Border>

            <Label
                x:Name="UsernameLabel"
                Grid.Row="0"
                Grid.Column="1"
                Padding="8,4,0,0"
                Style="{x:StaticResource FluentCardUsernameStyle}" />
        </Grid>
    </Border>
</ContentView>
<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Shiemi.Views.ProfileCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Shiemi.Views"
    x:DataType="views:ProfileCard">
    <Border
        HeightRequest="250"
        Stroke="LightGrey"
        StrokeShape="RoundRectangle 16"
        StrokeThickness="1"
        WidthRequest="200">
        <Grid RowDefinitions="Auto,Auto">
            <Border
                Grid.Row="0"
                HeightRequest="150"
                Stroke="Transparent">
                <Image
                    x:Name="ProfileImage"
                    Grid.Row="0"
                    Aspect="AspectFill" />
            </Border>

            <Label
                x:Name="UsernameLabel"
                Grid.Row="1"
                Padding="4,0,0,0"
                FontSize="20"
                LineBreakMode="TailTruncation"
                Style="{StaticResource CardTitleLabel}" />
        </Grid>
    </Border>
</ContentView>
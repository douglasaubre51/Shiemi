<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Shiemi.Views.ProfileCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Shiemi.Views"
    x:DataType="views:ProfileCard">
    <Border
        BackgroundColor="#f4f4f4"
        HeightRequest="150"
        MinimumWidthRequest="300"
        Style="{StaticResource CardBorderStyle}">
        <Grid
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8"
            RowDefinitions="Auto">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 50">
                <Image
                    x:Name="ProfileImage"
                    Aspect="AspectFit"
                    HeightRequest="100"
                    WidthRequest="100" />
            </Border>

            <Label
                x:Name="UsernameLabel"
                Grid.Column="1"
                LineBreakMode="WordWrap"
                Style="{StaticResource CardTitleLabel}" />
        </Grid>
    </Border>
</ContentView>